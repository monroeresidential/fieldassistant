# Droplet-level compose interpolation file: /opt/fieldassistant/deploy/.env
# Not read by the API containers. Plain KEY=value lines, no quotes, LF endings.
DOMAIN=fieldassistant.tools
POSTGRES_DEV_PASSWORD=
POSTGRES_PROD_PASSWORD=
# Bucket name, optionally with a folder prefix (for example field-assistant/backup).
SPACES_BUCKET=
