# Dev API stack: copy to /opt/fieldassistant/deploy/.env.dev and fill in.
# Procore SANDBOX credentials only. Plain KEY=value lines, no quotes, LF endings.
PORT=8080
# URL-encode special characters in the password (@ becomes %40).
DATABASE_URL=postgres://fa:<POSTGRES_DEV_PASSWORD>@postgres-dev:5432/fieldassistant?sslmode=disable
# Test-only; leave empty on the droplet.
TEST_DATABASE_URL=
# Sandbox app client id and secret from the Procore Developer Portal.
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_LOGIN_URL=https://login-sandbox.procore.com
PROCORE_API_URL=https://sandbox.procore.com
PROCORE_REDIRECT_URL=https://api-dev.fieldassistant.tools/v1/auth/callback
# Generate fresh values per environment; never reuse the prod ones.
TOKEN_VAULT_KEY=
SESSION_SECRET=
# Reserved: required by config, not yet read by the server.
PUBLIC_BASE_URL=https://api-dev.fieldassistant.tools
# URL scheme the backend uses to hand control back to the dev app build.
APP_REDIRECT_SCHEME=fieldassistant-dev
# Generate the key in the Anthropic Console; one key per environment.
ANTHROPIC_API_KEY=
# Model used for RFI extraction.
LLM_EXTRACT_MODEL=claude-sonnet-5-5
# Timeout for each LLM API request, in seconds. One extraction makes up to
# eight requests (six lookups, the final answer, one spare) and is bounded at
# eight times this value.
LLM_TIMEOUT_SECONDS=20
# Attachments bucket (DigitalOcean Spaces). The API refuses to start without
# these five lines. Leave OBJECT_STORE_CREATE_BUCKET unset: it is for local MinIO.
OBJECT_STORE_ENDPOINT=https://<region>.digitaloceanspaces.com
OBJECT_STORE_REGION=<region>
OBJECT_STORE_BUCKET=fieldassistant-attachments
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
# How the app learns, before recording, whether the user may create RFIs on a
# project: rfi_managers (the default) asks Procore with the user's token;
# create_outcome follows the user's last RFI create.
# FEATURES_PROBE=rfi_managers
