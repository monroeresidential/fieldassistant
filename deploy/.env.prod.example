# Prod API stack: copy to /opt/fieldassistant/deploy/.env.prod and fill in.
# Procore PRODUCTION credentials only. Plain KEY=value lines, no quotes, LF endings.
PORT=8080
# URL-encode special characters in the password (@ becomes %40).
DATABASE_URL=postgres://fa:<POSTGRES_PROD_PASSWORD>@postgres-prod:5432/fieldassistant?sslmode=disable
# Test-only; leave empty on the droplet.
TEST_DATABASE_URL=
# Production app client id and secret from the Procore Developer Portal.
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_LOGIN_URL=https://login.procore.com
PROCORE_API_URL=https://api.procore.com
PROCORE_REDIRECT_URL=https://api.fieldassistant.tools/v1/auth/callback
# Generate fresh values per environment; never reuse the dev ones.
TOKEN_VAULT_KEY=
SESSION_SECRET=
# Reserved: required by config, not yet read by the server.
PUBLIC_BASE_URL=https://api.fieldassistant.tools
# URL scheme the backend uses to hand control back to the app.
APP_REDIRECT_SCHEME=fieldassistant
# Generate the key in the Anthropic Console; one key per environment.
ANTHROPIC_API_KEY=
# Model used for RFI extraction.
LLM_EXTRACT_MODEL=claude-sonnet-5-5
# Timeout for each LLM API request, in seconds. One extraction makes up to
# eight requests (six lookups, the final answer, one spare) and is bounded at
# eight times this value.
LLM_TIMEOUT_SECONDS=20
