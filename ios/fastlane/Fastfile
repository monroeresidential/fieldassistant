default_platform(:ios)

SPM_FLAGS = "-skipPackagePluginValidation -onlyUsePackageVersionsFromResolvedFile"

platform :ios do
  desc "Run the unit tests on the iPhone 17 simulator"
  lane :test do
    sh("make", "-C", "..", "ios-project")
    run_tests(
      scheme: "FieldAssistant",
      devices: ["iPhone 17"],
      xcargs: SPM_FLAGS
    )
  end

  desc "Build the Dev configuration (api-dev, DEV badge, .dev bundle id) and upload it to TestFlight"
  lane :beta_dev do
    build_and_upload(configuration: "Dev", app_identifier: "com.monroeresidential.fieldassistant.dev")
  end

  desc "Build the Prod configuration and upload it to TestFlight"
  lane :beta_prod do
    build_and_upload(configuration: "Prod", app_identifier: "com.monroeresidential.fieldassistant")
  end

  # Builds `configuration` and uploads it to the App Store Connect app `app_identifier`.
  # The bundle id itself comes from ios/Config/<configuration>.xcconfig; the two must match.
  private_lane :build_and_upload do |options|
    configuration = options.fetch(:configuration)
    app_identifier = options.fetch(:app_identifier)

    # Regenerates the Xcode project with the pinned Swift packages.
    sh("make", "-C", "..", "ios-project")

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    build_app(
      scheme: "FieldAssistant",
      configuration: configuration,
      export_method: "app-store",
      xcargs: SPM_FLAGS
    )

    upload_to_testflight(app_identifier: app_identifier, skip_waiting_for_build_processing: true)
  end
end
