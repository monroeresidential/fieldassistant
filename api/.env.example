PORT=8080
DATABASE_URL=postgres://fa:fa@localhost:5432/fieldassistant?sslmode=disable
TEST_DATABASE_URL=postgres://fa:fa@localhost:5432/fieldassistant_test?sslmode=disable
# URL scheme the auth callback redirects to (fieldassistant-dev in the dev environment).
APP_REDIRECT_SCHEME=fieldassistant
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_LOGIN_URL=
PROCORE_API_URL=
PROCORE_REDIRECT_URL=http://localhost:8080/v1/auth/callback
TOKEN_VAULT_KEY=
SESSION_SECRET=
# Reserved: required by config, not yet read by the server.
PUBLIC_BASE_URL=http://localhost:8080
# Anthropic API key for RFI extraction.
ANTHROPIC_API_KEY=
# Model used for RFI extraction.
LLM_EXTRACT_MODEL=claude-sonnet-5-5
# Timeout for each LLM API request, in seconds. One extraction makes up to
# eight requests (six lookups, the final answer, one spare) and is bounded at
# eight times this value.
LLM_TIMEOUT_SECONDS=20
